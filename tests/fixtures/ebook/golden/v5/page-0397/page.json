    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0397:block:0004",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0397:block:0004:span:0001",
          "text": "Thời cắp sách đến trường, cô giáo dạy toán thực sự là nỗi ám ảnh đối với bọn học văn chúng tôi đến nỗi, thời sinh viên tuy mỗi đứa một trường nhưng đều có chung một ác mộng là ngày mai kiểm tra toán. (Kiểm tra 1 tiết mà cô ra đến 5 đề chéo cánh.)"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",

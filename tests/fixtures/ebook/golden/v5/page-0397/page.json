            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0397:block:0003:span:0001",
          "text": "Tôi xin trích câu chuyện của bạn Nguyễn Thanh Nga, mời các bạn tham khảo:"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",

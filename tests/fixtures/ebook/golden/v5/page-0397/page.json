            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0397:block:0005:span:0001",
          "text": "Hôm họp lớp vừa rồi gặp lại cô với mái tóc bạc trắng, sà đến bên cô tí toét:"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",

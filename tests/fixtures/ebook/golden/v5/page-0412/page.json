          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0003:span:0001",
          "text": "Tôi nhờ Minh Khuê đổi mật khẩu gmail thường xuyên với lý do:"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 2
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0412:block:0004",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0004:span:0001",
          "text": "Mẹ quên mật khẩu rồi, con nhớ giúp mẹ với, mẹ nhiều việc nên hay quên quá con ạ”."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,
        "raw_text": null
      },
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 3
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0412:block:0005",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0005:span:0001",
          "text": "Mẹ thật thiếu trách nhiệm, con cài mật khẩu cho mẹ xong là con quên liền, mẹ phải tự nhớ lấy chứ, đó là nguyên tắc bảo mật cá nhân mà."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,
        "raw_text": null
      },
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 4
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0412:block:0006",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0006:span:0001",
          "text": "Ôi dào, hòm thư của mẹ toàn thư công việc, bài vở, chứ có gì đâu mà phải bảo mật riêng tư, nhất là với con!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,
        "raw_text": null
      },
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 5
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0412:block:0007",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0007:span:0001",
          "text": "Nhưng con không thích quan tâm đến riêng tư của mẹ, và ngược lại con cũng không thích mẹ quan tâm đến riêng tư của con. Ai cũng có quyền bảo mật riêng tư!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,
        "raw_text": null
      },
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 6
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0412:block:0008",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0008:span:0001",
          "text": "Tất nhiên là mẹ tôn trọng riêng tư của con, đến cả cặp sách của con, chưa bao giờ mẹ lục lọi cơ mà, huống gì gmail của con!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,
        "raw_text": null
      },
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 7
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0412:block:0009",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0412:block:0009:span:0001",
          "text": "Ôi, con thấy nhiều cha mẹ nói thế nhưng vẫn cứ rình đọc trộm tin nhắn, thư từ của con cái, mẹ ạ!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,

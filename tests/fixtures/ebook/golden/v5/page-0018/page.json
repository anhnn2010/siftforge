            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0018:block:0001:span:0001",
          "text": "bước trưởng thành của tôi, hay những người mà sự hiện diện của họ làm tôi trân trọng hơn bất cứ gì!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 0
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0018:block:0002",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0018:block:0002:span:0001",
          "text": "Tôi đã tìm thấy bản thân mình ở nơi đây và tận hưởng niềm hạnh phúc nhìn thấy sự trưởng thành của bản thân, từng chút, từng chút một. Tôi cảm thấy biết ơn tất cả những người đã giúp tôi được ở đây ngày hôm nay."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 1
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0018:block:0003",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0018:block:0003:span:0001",
          "text": "Tôi biết ơn Mẹ, người bạn tri kỷ và người đồng hành tuyệt vời nhất của tôi, người luôn đặt lòng tin vào tôi ngay cả khi tôi hoài nghi bản thân mình nhất, người không bao giờ hỏi tôi về tình yêu của tôi dành cho bà ấy ngay cả trong những giây phút ương bướng, nổi loạn nhất của tuổi dậy thì."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 2
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0018:block:0004",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0018:block:0004:span:0001",
          "text": "Một người đặc biệt tôi gặp ở Harvard đã có lần nói với tôi: “Tôi làm việc chăm chỉ để ‘một tôi thành công’ của tương lai sẽ nhìn và cảm ơn ‘tôi của hiện tại’."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 3
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0018:block:0005",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0018:block:0005:span:0001",
          "text": "Vâng, đây là lời cảm tạ cho “tôi của quá khứ”, vì đã luôn lao động và học tập chăm chỉ, hy sinh như có thể, để tôi có được “tôi của hôm nay”."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 4
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0018:block:0006",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0018:block:0006:span:0001",
          "text": "Và, tôi đã sẵn sàng cho tất cả để chào đón những thách thức và khó khăn đang chờ tôi phía trước, bởi thành công của ngày mai sẽ đặt tên cho công việc tôi làm ngày hôm nay”."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",

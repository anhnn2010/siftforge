      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0006:span:0001",
          "text": "Lý do:"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 5
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0152:block:0007",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0007:span:0001",
          "text": "Hoặc vì ngại làm tổn thương bạn bè, nếu biết con cái họ không thành công lắm trong rèn luyện trưởng thành, nhiều khi là nhìn theo chủ quan của cha mẹ thường bị mắc dính vào so sánh kiểu “"
        },
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0007:span:0002",
          "text": "con người ta"
        },
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0007:span:0003",
          "text": "”."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": {
        "kind": "graphic",
        "ordinal": null,

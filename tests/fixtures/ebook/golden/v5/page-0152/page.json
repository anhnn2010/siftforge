      "block_id": "pdf:aa1ef056169f:page:0152:block:0008",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0008:span:0001",
          "text": "Hoặc tránh nhắc đến vì sợ bị mang tiếng là khoe khoang, sợ bị đánh giá là “"
        },
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0008:span:0002",
          "text": "thích kể công với con cái"
        },
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0008:span:0003",
          "text": "”. Và do đó, người ta thường lựa chọn cách an toàn là im lặng cho lành!"
        }
      ],

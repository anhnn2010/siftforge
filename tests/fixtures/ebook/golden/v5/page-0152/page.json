            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0002:span:0001",
          "text": "Có câu ca dao dân gian rất nhân văn, mà dường như người Việt nào cũng thấy thân thuộc:"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 1
    },
    {
      "alignment": "center",
      "block_id": "pdf:aa1ef056169f:page:0152:block:0003",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": true,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0003:span:0001",
          "text": "“Có vàng, vàng chẳng hay phô"
        },
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "italic",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0003:span:0002",
          "text": "Có con, con nói trầm trồ mẹ nghe.”"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "verse",
      "sequence_index": 2
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0152:block:0004",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0004:span:0001",
          "text": "Điều này, hoàn toàn dễ dàng được chia sẻ, đồng thuận khi mà trẻ còn ở tuổi nhũ nhi, ấu nhi và hơn một chút là ở tuổi đồng nhi.Tuy nhiên, khi những đứa trẻ đã lớn, con cái đã lớn thì mọi việc có khác!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 3
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0152:block:0005",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0152:block:0005:span:0001",
          "text": "Trong cảm thức xã hội hiện nay, tôi nhận ra một dấu hiệu: khi con cái lớn, những đứa trẻ đã thành niên và lúc này, các bậc phụ huynh ngại kể về con cái."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 4
    },
    {
      "alignment": "left",

            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "bold"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0005:span:0001",
          "text": "Bật lại!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": 3,
      "heading_role_hint": "scenario_title",
      "marker": null,
      "region": null,
      "role_hint": "heading",
      "sequence_index": 4
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0006",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0006:span:0001",
          "text": "Bước vào tuổi vị thành niên, Minh Khuê có biểu hiện hay lườm nguýt mẹ mỗi khi bất đồng ý kiến. Một lần, tôi bắt gặp cái lườm dài của con gái, nén nỗi tổn thương trong lòng, tôi bảo:"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 5
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0007",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0007:span:0001",
          "text": "“Khi bất đồng ý kiến thì con nên thẳng thắn thể hiện quan điểm, không nên lườm nguýt, đó là biểu hiện thiếu đàng hoàng!”"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 6
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0008",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0008:span:0001",
          "text": "“Con không lườm nguýt, nếu mẹ không nhìn trộm con, sao mẹ biết con lườm nguýt?”"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 7
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0009",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0009:span:0001",
          "text": "“Mẹ bất chợt quay lại và nhìn thấy!”"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 8
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0010",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0010:span:0001",
          "text": "“Tại sao mẹ cứ áp đặt cách hiểu của mẹ? Con khẳng định là con không lườm nguýt!”"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 9
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0011",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0011:span:0001",
          "text": "Đây là một tình huống sư phạm hóc búa, và đòi hỏi người mẹ phải thật sáng suốt. Tôi nỗ lực thuyết phục con gái bằng"
        }
      ],

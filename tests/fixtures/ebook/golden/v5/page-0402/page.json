            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0001:span:0001",
          "text": "Câu nói tôi thường được nghe là: “Con chị ngoan hiền dễ dạy, chứ con nhà em cá tính lắm, khó dạy lắm!”."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 0
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0002",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0002:span:0001",
          "text": "Bạn đừng nhầm lẫn hai khái niệm này trong huấn luyện trẻ vì như vậy thật là lãng phí."
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 1
    },
    {
      "alignment": "justify",
      "block_id": "pdf:aa1ef056169f:page:0402:block:0003",
      "content": [
        {
          "language": "vi",
          "semantic_line_break_after": false,
          "source_typography": {
            "caps_style": "normal",
            "decorations": [],
            "posture": "roman",
            "vertical_position": "baseline",
            "weight": "normal"
          },
          "span_id": "pdf:aa1ef056169f:page:0402:block:0003:span:0001",
          "text": "Có trẻ thì có cá tính mạnh, có trẻ thì biếng ăn hay có một chứng tật nào đó, v.v... không đứa trẻ nào bắt đầu đã hoàn hảo! Do đó, cha mẹ cần nỗ lực nhiều hơn 10 lần, 20 hoặc hơn thế nữa, không có con đường nào khác, để giúp trẻ có được “trật tự nội tâm”, “kỷ luật nội tâm”. Khi làm được như vậy, chắc chắn trẻ sẽ rất sáng tạo, mạnh mẽ nội lực và lan tỏa đến xung quanh!"
        }
      ],
      "dominant_language": "vi",
      "heading_level_hint": null,
      "heading_role_hint": "unknown",
      "marker": null,
      "region": null,
      "role_hint": "paragraph",
      "sequence_index": 2
    },
    {
